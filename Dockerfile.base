FROM nvidia/cuda:13.0.2-cudnn-devel-ubuntu24.04

# Set environment variables to avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install system dependencies
RUN apt-get update -qq && \
    apt-get install -y \
    curl \
    jq \
    git-lfs \
    ninja-build \
    gettext-base \
    aria2 \
    zip \
    libgl1 \
    libglib2.0-0 \
    debian-keyring \
    debian-archive-keyring \
    apt-transport-https \
    gpg \
    && rm -rf /var/lib/apt/lists/*

# Install UV package manager, setup repositories, and install additional tools
RUN curl -LsSf https://astral.sh/uv/0.9.10/install.sh && \
    # Setup gum repository and install gum
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://repo.charm.sh/apt/gpg.key | gpg --dearmor -o /etc/apt/keyrings/charm.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" | tee /etc/apt/sources.list.d/charm.list > /dev/null && \
    # Setup Caddy repository and install Caddy
    curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg && \
    curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | tee /etc/apt/sources.list.d/caddy-stable.list > /dev/null && \
    # Update package lists and install tools
    apt-get -qq update && \
    apt-get install -y gum caddy && \
    # Clean up
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Set default shell
SHELL ["/bin/bash", "-c"]