# The Caddyfile is an easy way to configure your Caddy web server.
#
# Unless the file starts with a global options block, the first
# uncommented line is always the address of your site.
#
# To use your own domain name (with automatic HTTPS), first make
# sure your domain's A/AAAA DNS records are properly pointed to
# this machine's public IP, then replace ":80" below with your
# domain name.

# CORS Preflight (OPTIONS) + Request (GET, POST, PATCH, PUT, DELETE)
(cors-api) {
	@match-cors-api-preflight method OPTIONS
	handle @match-cors-api-preflight {
		header {
			Access-Control-Allow-Origin "{http.request.header.origin}"
			Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
			Access-Control-Allow-Headers "Origin, Accept, Authorization, Content-Type, X-Requested-With"
			Access-Control-Allow-Credentials "true"
			Access-Control-Max-Age "3600"
			defer
		}
		respond "" 204
	}

	@match-cors-api-request {
		not {
			header Origin "{http.request.scheme}://{http.request.host}"
		}
		header Origin "{http.request.header.origin}"
	}
	handle @match-cors-api-request {
		header {
			Access-Control-Allow-Origin "{http.request.header.origin}"
			Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
			Access-Control-Allow-Headers "Origin, Accept, Authorization, Content-Type, X-Requested-With"
			Access-Control-Allow-Credentials "true"
			Access-Control-Max-Age "3600"
			defer
		}
	}
}

:${CADDY_PORT} {
    log {
        output file ${LOG_DIR}/caddy.log {
            roll_size 100MiB     # Roll at 100MB (default)
            roll_keep 10         # Keep 10 files (default)
            roll_keep_for 2160h  # Keep for 90 days (default)
        }
    }

    handle_errors {
        respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
    }

    file_server
    
    # Handle Jupyter WebSocket connections with regex matching
    @jupyter_ws {
        path_regexp jupyter ^/api/kernels/[^/]+/(channels|iopub|shell|stdin)/?$|^/terminals/websocket/?$
    }

    handle @jupyter_ws {
        reverse_proxy localhost:8890 {
            # Set longer timeout for WebSocket connections
            transport http {
                read_timeout 86400s
            }
        }
    }
    

{% for item in data %}
    handle_path /{{ item['name']|replace('_', '-') }}/* {
        {% if item['caddy_override'] %}
        {{ item['caddy_override']|indent(8) }}
        {% else %}
        import cors-api
        reverse_proxy localhost:{{ item['port'] }}
        {% endif %}
    }

    {% if item['caddy_extra'] %}
    {{ item['caddy_extra'] }}
    {% endif %}
{% endfor %}

}

# Refer to the Caddy docs for more information:
# https://caddyserver.com/docs/caddyfile