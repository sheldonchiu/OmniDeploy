current_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
source $WORKING_DIR/.env
source $WORKING_DIR/utils/helper.sh


export REQUIRED_ENV=""


export MODEL_DIR=${OPENWEBUI_MODEL_DIR:-"$DATA_DIR/llm-models"}

export OPENWEBUI_PORT=7021

export EXPOSE_PORTS="$EXPOSE_PORTS:$OPENWEBUI_PORT"
export PORT_MAPPING="$PORT_MAPPING:openwebui"

export DATA_DIR=$ROOT_REPO_DIR/settings/openwebui