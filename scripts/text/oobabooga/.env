current_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
source $WORKING_DIR/.env
source $WORKING_DIR/utils/helper.sh


export REQUIRED_ENV=""


export GRADIO_ROOT_PATH=/textgen
export MODEL_DIR=${OOBABOOGA_MODEL_DIR:-"$DATA_DIR/llm-models"}
export REPO_DIR=${OOBABOOGA_REPO_DIR:-"$ROOT_REPO_DIR/text-generation-webui"}

export OOBABOOGA_PORT= 7009
export OOBABOOGA_OPENAI_API_PORT=${OOBABOOGA_OPENAI_API_PORT:-7013}
export EXPOSE_PORTS="$EXPOSE_PORTS:$OOBABOOGA_PORT:$OOBABOOGA_OPENAI_API_PORT"
export PORT_MAPPING="$PORT_MAPPING:oobabooga:oobabooga_openai_api"
export HUGGINGFACE_TOKEN=$HF_TOKEN

export LINK_MODEL_TO=${OOBABOOGA_LINK_MODEL_TO:-"$REPO_DIR/models"}