current_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
source $WORKING_DIR/.env
source $WORKING_DIR/utils/helper.sh


export REQUIRED_ENV=""


export MODEL_DIR=${OLLAMA_MODEL_DIR:-"$DATA_DIR/llm-models"}
export OLLAMA_MODELS=$MODEL_DIR

export OLLAMA_PORT=11434
export OLLAMA_HOST=0.0.0.0:11434

export EXPOSE_PORTS="$EXPOSE_PORTS:$OLLAMA_PORT"
export PORT_MAPPING="$PORT_MAPPING:ollama"