current_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
source $WORKING_DIR/.env
source $WORKING_DIR/utils/helper.sh


export REQUIRED_ENV=""


export MODEL_DIR="$DATA_DIR/sovits_models"
export HF_HOME="$DATA_DIR/hf"
export REPO_DIR="$ROOT_REPO_DIR/GPT-SoVITS"

export GPT_SOVITS_PORT="9874,9873,9872,9871,9880"
export EXPOSE_PORTS="$EXPOSE_PORTS:$GPT_SOVITS_PORT"
export PORT_MAPPING="$PORT_MAPPING:gpt_sovits,gpt_sovits,gpt_sovits,gpt_sovits,gpt_sovits"
export HUGGINGFACE_TOKEN=$HF_TOKEN