current_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
source $WORKING_DIR/.env
source $WORKING_DIR/utils/helper.sh


export REQUIRED_ENV=""



export MODEL_DIR=${INVOKEAI_MODEL_DIR:-"$DATA_DIR/models"}
export REPO_DIR=${INVOKEAI_REPO_DIR:-"$ROOT_REPO_DIR/stable-diffusion-invokeai"}
export INVOKEAI_ROOT=$ROOT_REPO_DIR/settings/invokeai
export HUGGING_FACE_HUB_TOKEN=$HF_TOKEN

export INVOKEAI_PORT=${INVOKEAI_PORT:-"7006"}
export EXPOSE_PORTS="$EXPOSE_PORTS:$INVOKEAI_PORT"
export PORT_MAPPING="$PORT_MAPPING:invokeai"
export HUGGINGFACE_TOKEN=$HF_TOKEN