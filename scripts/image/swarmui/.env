current_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
source $WORKING_DIR/.env
source $WORKING_DIR/utils/helper.sh


export REQUIRED_ENV=""


export MODEL_DIR=${SWARMUI_MODEL_DIR:-"$DATA_DIR/stable-diffusion-models"}
export REPO_DIR=${SWARMUI_REPO_DIR:-"$ROOT_REPO_DIR/StableSwarmUI"}

export SWARMUI_PORT=${SWARMUI_PORT:-"7016"}
export EXPOSE_PORTS="$EXPOSE_PORTS:$SWARMUI_PORT"
export PORT_MAPPING="$PORT_MAPPING:swarmui"

export LINK_MODEL_TO=${SWARMUI_LINK_MODEL_TO:-"${REPO_DIR}/Models/Stable-Diffusion"}
export LINK_VAE_TO=${SWARMUI_LINK_VAE_TO:-"${REPO_DIR}/Models/VAE"}
export LINK_HYPERNETWORK_TO=${SWARMUI_LINK_HYPERNETWORK_TO:-"${REPO_DIR}/Models/hypernetworks"}
export LINK_LORA_TO=${SWARMUI_LINK_LORA_TO:-"${REPO_DIR}/Models/Lora"}
export LINK_CONTROLNET_TO=${SWARMUI_LINK_CONTROLNET_TO:-"${REPO_DIR}/Models/controlnet"}
export LINK_EMBEDDING_TO=${SWARMUI_LINK_EMBEDDING_TO:-"${REPO_DIR}/Models/Embeddings"}
export LINK_CLIP_TO=${SWARMUI_LINK_CLIP_TO:-"${REPO_DIR}/Models/clip_vision"}