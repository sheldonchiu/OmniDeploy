current_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
source $WORKING_DIR/.env
source $WORKING_DIR/utils/helper.sh


export REQUIRED_ENV=""


export MODEL_DIR="$DATA_DIR/models"
export HF_HOME="$DATA_DIR/hf"
export REPO_DIR="$ROOT_REPO_DIR/Wan2GP"

export WAN2GP_PORT="None"
export EXPOSE_PORTS="$EXPOSE_PORTS:$WAN2GP_PORT"
export PORT_MAPPING="$PORT_MAPPING:wan2gp"
export HUGGINGFACE_TOKEN=$HF_TOKEN