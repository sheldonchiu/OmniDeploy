#!/bin/bash

export DEBIAN_FRONTEND=noninteractive

export DATA_DIR=${DATA_DIR:-"/tmp"}
if env | grep -q "PAPERSPACE"; then
    export WORKING_DIR=${WORKING_DIR:-"/notebooks"}
    export ROOT_REPO_DIR=${ROOT_REPO_DIR:-"/storage"}
else
    export WORKING_DIR=${WORKING_DIR:-"/workspace/OmniDeploy"}
    export ROOT_REPO_DIR=${ROOT_REPO_DIR:-"/workspace/storage"}
fi
export VENV_DIR=${VENV_DIR:-"/tmp"}
export UV_CACHE_DIR="$VENV_DIR/uv_cache"
export UV_INSTALL_DIR="$VENV_DIR/bin"
export UV_NO_PROGRESS=1
export LOG_DIR=${LOG_DIR:-"/tmp/log"}
export IMAGE_OUTPUTS_DIR="$ROOT_REPO_DIR/image_outputs"

export CADDY_PORT=${CADDY_PORT:-"8888"}